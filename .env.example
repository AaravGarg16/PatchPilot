# Copy to .env and fill in. Never commit .env.

# Provider and model are passed to LangChain's init_chat_model.
# Defaults: anthropic / claude-sonnet-5. Switching provider also needs its LangChain package installed.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
# Needed once PatchPilot works against GitHub repos.
GITHUB_TOKEN=

# Local Postgres with pgvector (brew install postgresql@17 pgvector). Default shown.
DATABASE_URL=postgresql://localhost:5432/patchpilot
# Tests use a separate database. Default shown.
TEST_DATABASE_URL=postgresql://localhost:5432/patchpilot_test

# Local embeddings through fastembed; no API cost. Any fastembed model works, e.g. BAAI/bge-small-en-v1.5 (67 MB).
EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_CACHE_DIR=~/.cache/patchpilot/fastembed

# Langfuse tracing. Off unless both keys are set. Cloud: https://cloud.langfuse.com (free tier), or self-hosted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Set to false to turn tracing off without removing the keys. The test suite always forces it off.
LANGFUSE_TRACING_ENABLED=true
