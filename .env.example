# Copy to .env and fill in. Never commit .env.

# Provider and model are passed to LangChain's init_chat_model.
# Defaults: anthropic / claude-sonnet-5. Switching provider also needs its LangChain package installed.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5

ANTHROPIC_API_KEY=
# Needed from Phase 2 for cloning and diffing against GitHub repos.
GITHUB_TOKEN=
